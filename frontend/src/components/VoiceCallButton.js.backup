import { useState, useEffect } from 'react';
import { Zap, X, Mic } from 'lucide-react';
import axios from 'axios';

// GLOBAL SINGLETON STATE - shared across ALL component instances
const GlobalCallState = {
  isActive: false,
  currentQuestion: '',
  isListening: false,
  transcript: '',
  questionIndex: 0,
  answers: ['', '', ''],
  listeners: new Set(),
  
  notify() {
    this.listeners.forEach(fn => fn());
  },
  
  subscribe(fn) {
    this.listeners.add(fn);
    return () => this.listeners.delete(fn);
  }
};

let wakeWordListener = null;
let recognitionInstance = null;

let wakeWordListener = null;
let recognitionInstance = null;

const questions = [
  "What type of incident? Say fire, medical, security, or other.",
  "How severe is it? Say low, medium, or high.",
  "Any additional information?"
];

export default function VoiceCallButton({ userEmail = 'CrisisCtrl1@gmail.com', onCallComplete = null }) {
  const [, forceUpdate] = useState({});
  
  // Subscribe to global state changes
  useEffect(() => {
    return GlobalCallState.subscribe(() => forceUpdate({}));
  }, []);

  // 🛡️ FORCE SINGLE INSTANCE: Create global modal container
  useEffect(() => {
    if (typeof window !== 'undefined' && !globalModalContainer) {
      // Remove any existing containers first
      const existingContainers = document.querySelectorAll('#voice-call-global-container');
      existingContainers.forEach(c => c.remove());
      
      // Create ONE global container
      globalModalContainer = document.createElement('div');
      globalModalContainer.id = 'voice-call-global-container';
      document.body.appendChild(globalModalContainer);
      console.log('✅ Created SINGLE global modal container');
    }
    
    return () => {
      // Cleanup on unmount
      if (globalModalContainer && globalModalContainer.parentNode) {
        globalModalContainer.remove();
        globalModalContainer = null;
      }
    };
  }, []);

  // �🔊 VOICE WAKE WORD LISTENER
  useEffect(() => {
    if (!isCallActive && typeof window !== 'undefined' && 'webkitSpeechRecognition' in window) {
      const wakeListener = new window.webkitSpeechRecognition();
      wakeListener.lang = 'en-US';
      wakeListener.continuous = true;
      wakeListener.interimResults = true;

      wakeListener.onresult = (event) => {
        for (let i = event.resultIndex; i < event.results.length; i++) {
          const said = event.results[i][0].transcript.toLowerCase();
          console.log('🎧 Listening:', said);
          
          if ((said.includes('crisis') || said.includes('chris')) && 
              (said.includes('control') || said.includes('ctrl')) && 
              said.includes('help')) {
            console.log('✅✅✅ WAKE WORD DETECTED! ✅✅✅');
            wakeListener.stop();
            startCall();
            break;
          }
        }
      };

      wakeListener.onerror = (e) => {
        if (e.error !== 'no-speech' && e.error !== 'aborted') {
          console.log('Wake error:', e.error);
        }
      };

      wakeListener.onend = () => {
        if (!isCallActive) {
          setTimeout(() => {
            try { 
              wakeListener.start();
              console.log('🔄 Wake listener restarted');
            } catch(e) {}
          }, 200);
        }
      };

      try {
        wakeListener.start();
        wakeWordListenerRef.current = wakeListener;
        console.log('🎧 WAKE WORD ACTIVE: Say "crisis control help"');
      } catch(e) {
        console.error('Failed to start wake listener:', e);
      }

      return () => {
        if (wakeWordListenerRef.current) {
          try {
            wakeWordListenerRef.current.stop();
          } catch(e) {}
        }
      };
    }
  }, [isCallActive]);

  const startCall = () => {
    // GLOBAL SINGLETON CHECK
    if (globalCallActive || isCallActive || callStartedRef.current) {
      console.log('⚠️ Call already active - BLOCKED DUPLICATE');
      return;
    }
    
    console.log('🚀 STARTING CALL (Global container ensures only ONE modal)');
    globalCallActive = true;
    callStartedRef.current = true;
    
    console.log('================================================');
    console.log('STARTING EMERGENCY CALL');
    console.log('================================================');
    
    // STOP WAKE WORD LISTENER IMMEDIATELY
    if (wakeWordListenerRef.current) {
      try {
        wakeWordListenerRef.current.stop();
        wakeWordListenerRef.current = null;
        console.log('Wake word listener STOPPED');
      } catch(e) {}
    }
    
    setIsCallActive(true);
    setQuestionIndex(0);
    setAnswers(['', '', '']);
    answersRef.current = ['', '', ''];
    
    console.log('Will speak in 1 second...');
    setTimeout(() => {
      speak(questions[0], 0);
    }, 1000);
  };

  const speak = (text, qIndex) => {
    console.log('================================================');
    console.log('🗣️ AI SPEAKING Q', qIndex + 1, ':', text);
    console.log('================================================');
    
    setCurrentQuestion(text);
    setQuestionIndex(qIndex);
    
    // Create speech utterance
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'en-US';
    utterance.rate = 0.9;
    utterance.volume = 1.0;
    utterance.pitch = 1.0;
    
    utterance.onstart = () => {
      console.log('✅ SPEECH ACTIVE!');
    };
    
    utterance.onend = () => {
      console.log('✅ Speech done');
      console.log('Starting mic in 1 second...');
      setTimeout(() => {
        listen(qIndex);
      }, 1000);
    };
    
    utterance.onerror = (e) => {
      console.log('Speech error (continuing):', e.error);
      // Don't block - just go to listening
      setTimeout(() => {
        listen(qIndex);
      }, 500);
    };
    
    try {
      // Clear any existing speech
      if (window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
      }
      
      console.log('Speaking now...');
      window.speechSynthesis.speak(utterance);
    } catch (err) {
      console.log('Speech failed, going to mic:', err);
      setTimeout(() => listen(qIndex), 500);
    }
  };

  const listen = (currentQIndex) => {
    console.log('================================================');
    console.log('🎤 MICROPHONE ON FOR QUESTION', currentQIndex + 1);
    console.log('================================================');
    
    const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
    recognition.lang = 'en-US';
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.maxAlternatives = 1;

    let fullAnswer = '';
    let silenceTimeout = null;
    let isProcessing = false;

    recognition.onstart = () => {
      console.log('✅ MIC IS ON - SPEAK NOW AND KEEP SPEAKING');
      setIsListening(true);
      setTranscript('🎤 Listening... Speak now!');
    };

    recognition.onresult = (event) => {
      if (isProcessing) return;
      
      let interim = '';
      
      for (let i = 0; i < event.results.length; i++) {
        if (event.results[i].isFinal) {
          fullAnswer += event.results[i][0].transcript + ' ';
        } else {
          interim += event.results[i][0].transcript;
        }
      }
      
      const display = fullAnswer + interim;
      setTranscript(display);
      console.log('Hearing:', display);
      
      // Clear previous timeout
      if (silenceTimeout) {
        clearTimeout(silenceTimeout);
      }
      
      // Wait 3 seconds of silence before processing
      silenceTimeout = setTimeout(() => {
        if (fullAnswer.trim() && !isProcessing) {
          isProcessing = true;
          console.log('✅ COMPLETE:', fullAnswer.trim());
          recognition.stop();
          setIsListening(false);
          
          answersRef.current[currentQIndex] = fullAnswer.trim();
          setAnswers([...answersRef.current]);
          
          if (currentQIndex < 2) {
            setTimeout(() => {
              speak(questions[currentQIndex + 1], currentQIndex + 1);
            }, 1500);
          } else {
            submitReport(answersRef.current);
          }
        }
      }, 3000);
    };

    recognition.onerror = (event) => {
      console.log('Mic error:', event.error);
      
      if (event.error === 'no-speech') {
        // Don't restart immediately, just log
        console.log('Waiting for speech...');
      } else if (event.error === 'aborted' && !isProcessing) {
        console.log('Aborted - restarting in 1s');
        setTimeout(() => {
          if (!isProcessing) listen(currentQIndex);
        }, 1000);
      } else {
        setIsListening(false);
      }
    };

    recognition.onend = () => {
      console.log('Mic ended');
      if (silenceTimeout) clearTimeout(silenceTimeout);
      if (!isProcessing) {
        setIsListening(false);
      }
    };

    try {
      recognition.start();
      console.log('Recognition started - mic is active');
    } catch (error) {
      console.error('Failed to start mic:', error);
      setIsListening(false);
    }
  };

  const submitReport = (finalAnswers) => {
    console.log('All answers collected:', finalAnswers);
    console.log('Using email:', userEmail);
    speak('Thank you. Submitting your report now.');
    
    // Map severity to expected format
    const severityMap = {
      'low': 'Low',
      'medium': 'Medium',
      'high': 'Critical'
    };
    const severity = severityMap[finalAnswers[1]?.toLowerCase()] || 'Critical';
    
    navigator.geolocation.getCurrentPosition(
      async (position) => {
        try {
          const payload = {
            type: finalAnswers[0] || 'Emergency',
            severity: severity,
            description: finalAnswers[2] || 'No description provided',
            location: {
              lat: position.coords.latitude,
              lng: position.coords.longitude
            },
            email: userEmail,
            source: 'Voice Call'
          };
          console.log('Sending payload:', payload);
          
          const response = await axios.post('http://localhost:5001/api/sos', payload);
          
          console.log('Report submitted successfully:', response.data);
          setTimeout(() => {
            alert('✅ Emergency report submitted!');
            if (onCallComplete) {
              onCallComplete(finalAnswers);
            }
            endCall();
          }, 2000);
        } catch (error) {
          console.error('Submit error:', error);
          alert('Failed to submit: ' + (error.response?.data?.message || error.message));
          endCall();
        }
      },
      (geoError) => {
        console.error('Geolocation error:', geoError);
        alert('Location access denied. Please enable location.');
        endCall();
      }
    );
  };

  const endCall = () => {
    console.log('Ending call...');
    
    // Stop any active recognition
    if (recognitionRef.current) {
      try {
        recognitionRef.current.stop();
        recognitionRef.current = null;
      } catch(e) {}
    }
    
    globalCallActive = false;
    callStartedRef.current = false;
    setIsCallActive(false);
    setCurrentQuestion('');
    setTranscript('');
    setQuestionIndex(0);
    setIsListening(false);
    window.speechSynthesis.cancel();
  };

  return (
    <>
      <button
        onClick={isCallActive ? endCall : startCall}
        className={`fixed bottom-32 right-8 z-[1000] w-16 h-16 rounded-full shadow-2xl flex items-center justify-center transition-all transform hover:scale-110 ${
          isCallActive ? 'bg-red-600 animate-pulse' : 'bg-blue-600 animate-pulse'
        }`}
        aria-label="Voice Emergency Call - Say crisis control help to activate"
      >
        {isCallActive ? <X className="w-8 h-8 text-white" /> : <Zap className="w-8 h-8 text-white" />}
      </button>

      {isCallActive && globalModalContainer && createPortal(
        <div className="fixed bottom-56 right-8 z-[9999] bg-slate-900/95 backdrop-blur-xl border-2 border-cyan-500 rounded-2xl p-6 max-w-sm shadow-2xl">
          <div className="flex items-center justify-between mb-4">
            <h3 className="text-white font-bold text-lg">🚨 Emergency Call</h3>
            <button onClick={endCall} className="text-slate-400 hover:text-white">
              <X size={20} />
            </button>
          </div>

          <div className="space-y-4">
            {/* AI Question */}
            <div className="bg-slate-800 rounded-lg p-4">
              <p className="text-xs text-slate-400 mb-2">AI:</p>
              <p className="text-white text-sm font-semibold">{currentQuestion}</p>
            </div>

            {/* SINGLE LISTENING INDICATOR */}
            {isListening && (
              <div className="bg-red-600 rounded-lg p-6 text-center">
                <Mic className="w-12 h-12 text-white mx-auto mb-3 animate-pulse" />
                <p className="text-white font-bold text-2xl mb-2">🎤 LISTENING</p>
                <p className="text-red-100 text-sm">Speak your answer now!</p>
              </div>
            )}

            {/* Transcript */}
            {transcript && !isListening && (
              <div className="bg-green-900/50 border-2 border-green-500 rounded-lg p-4">
                <p className="text-green-400 text-xs mb-1">You said:</p>
                <p className="text-white font-semibold">{transcript}</p>
              </div>
            )}

            {/* Progress */}
            <div className="text-center text-slate-400 text-xs">
              Question {questionIndex + 1} of 3
            </div>
          </div>
        </div>,
        globalModalContainer
      )}
    </>
  );
}
