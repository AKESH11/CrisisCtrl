# Gmail SMTP Configuration (for sending email alerts)
GMAIL_EMAIL=your_gmail@gmail.com
GMAIL_PASSWORD=your_16_char_app_password

# OpenWeather API
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5001

# Twilio for Real Phone Calls (Professional Emergency Hotline)
# Get free trial: https://www.twilio.com/try-twilio ($15 credit free)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI API (Optional - for enhanced AI responses)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Setup Instructions:
# 1. Copy this to .env file
# 2. Get Twilio account: https://www.twilio.com/try-twilio
# 3. Buy phone number ($1/month) or use trial number
# 4. Configure webhook: Twilio Console > Phone Numbers > Voice Configuration
#    - A CALL COMES IN: Webhook, POST, https://your-domain.com/telephony/incoming
# 5. Use ngrok for local testing: ngrok http 5001
